@{
    ViewData["Title"] = "Doctor Departments";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1>Doctor Departments</h1>
        <p class="lead">Choose a department to find a doctor.</p>
    </div>

    <div class="row">

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm p-4 text-center">
                <h3>🩺 Medicine</h3>
                <p>General medicine and medical consultation.</p>
                <a href="#" class="btn btn-primary">View Doctors</a>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm p-4 text-center">
                <h3>❤️ Cardiology</h3>
                <p>Heart and cardiovascular specialists.</p>
                <a href="#" class="btn btn-primary">View Doctors</a>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm p-4 text-center">
                <h3>🦷 Dental</h3>
                <p>Dental and oral health specialists.</p>
                <a href="#" class="btn btn-primary">View Doctors</a>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm p-4 text-center">
                <h3>👩‍⚕️ Gynecology</h3>
                <p>Women's health and gynecology specialists.</p>
                <a href="#" class="btn btn-primary">View Doctors</a>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm p-4 text-center">
                <h3>🔪 Surgery</h3>
                <p>Surgical consultation and specialists.</p>
                <a href="#" class="btn btn-primary">View Doctors</a>
            </div>
        </div>

    </div>
